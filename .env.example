# Strava App credentials (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=olimpipo-webhook-verify

# Security
JWT_SECRET_KEY=change-me-in-production

# Service URLs
HEALTH_ACTIONS_BASE_URL=http://health-actions-mock:8001
STRAVA_REDIRECT_URI=http://localhost:8000/strava/callback

# DynamoDB local
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8001
DYNAMODB_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Olimpipo defaults
COMPANY_ID=
MIN_ACTIVITY_DURATION_SECONDS=1200
